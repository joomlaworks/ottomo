	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="COM_OTTOMO_SETTINGS_PERMISSIONS_DESC">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_ottomo" section="component" />
	</fieldset>
</config>
